#!/bin/sh
# rtk-gps-module pre-commit.
#
# design/ is hand-edited now, so this hook does NOT regenerate anything
# and does NOT block on style. It blocks on exactly one thing: an ERC
# ERROR in a commit that touches design/. Warnings never block.
#
# Remove with `make unhook`, or bypass once with `git commit --no-verify`.

git diff --cached --name-only | grep -q '^design/' || exit 0

if ls design/*.lck design/~*.lck >/dev/null 2>&1; then
    echo "pre-commit: KiCad has the project open; skipping ERC."
    echo "  (Save and close, then 'make check' when you get a chance.)"
    exit 0
fi

mkdir -p analysis
rm -f analysis/erc.rpt
kicad-cli sch erc --output analysis/erc.rpt --severity-all \
    design/rtk-gps-module.kicad_sch >/dev/null 2>&1

if [ ! -f analysis/erc.rpt ]; then
    echo "pre-commit: BLOCKED -- ERC produced no report."
    echo "  That usually means the schematic does not parse."
    exit 1
fi

errors=$(sed -n 's/.*ERC messages: [0-9]*  *Errors \([0-9]*\).*/\1/p' analysis/erc.rpt)
warns=$(sed -n 's/.*Warnings \([0-9]*\).*/\1/p' analysis/erc.rpt)

if [ "${errors:-0}" -gt 0 ]; then
    echo "pre-commit: BLOCKED -- $errors ERC error(s):"
    grep -B1 '; error' analysis/erc.rpt | sed 's/^/    /' | head -20
    echo
    echo "  Fix them, or 'git commit --no-verify' to commit anyway."
    exit 1
fi

[ "${warns:-0}" -gt 0 ] && echo "pre-commit: $warns ERC warning(s) (not blocking)"
echo "pre-commit: ERC clean"
