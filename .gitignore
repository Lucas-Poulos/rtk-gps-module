# KiCad local / session state
*.kicad_prl
*-backups/
_autosave-*
*.lck
fp-info-cache
~*.kicad_*

# KiCad export leftovers
*.net~
*-erc.json
*.drc

# Python
__pycache__/
*.py[cod]
.venv/

# macOS
.DS_Store

# Large cached datasheets: the URLs are in the generators, re-fetch as needed.
# hw.txt / saw.txt are pdftotext scratch, not sources.
datasheets/*.txt

# Vendor datasheets: fetch with scripts/fetch_datasheets.py, do not redistribute
datasheets/*.pdf

# Regenerated by scripts/verify_project.py on every run
analysis/

# KiCad 10 writes a local edit history beside the design
design/.history/
